# -----------------------------------------------------------------------------
# Langfuse (Phase 4 Task 2, OB-7) — self-hosted-friendly tracing alternative.
# Strictly opt-in: LANGFUSE_ENABLED=false (default) means the langfuse package
# is never imported and both callback chains are byte-identical to today.
# Requires LANGFUSE_ENABLED=true AND langfuse_host + both keys set.
# -----------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=                             # e.g. https://langfuse.internal.example.com
LANGFUSE_PUBLIC_KEY=                       # secret — comes from Bitwarden in prod
LANGFUSE_SECRET_KEY=                       # secret — comes from Bitwarden in prod

# -----------------------------------------------------------------------------
# Docker Compose infrastructure (docker/docker-compose.yml ONLY)
# -----------------------------------------------------------------------------
# These are read by docker-compose's ${VAR} interpolation, NOT by the app's
# Settings class. They provision the bundled postgres/redis/n8n/ui containers.
# Not needed when running the app standalone (use POSTGRES_URL above instead).
#
# DATABASE_URL must point at the compose `postgres` service host (not localhost)
# and is injected into the container as POSTGRES_URL. It OVERRIDES POSTGRES_URL
# above when running via compose, so keep credentials consistent.
DATABASE_URL=postgresql://infra:infra@postgres:5432/infra_brain
POSTGRES_DB=infra_brain
POSTGRES_USER=infra
POSTGRES_PASSWORD=infra              # change for any non-local deployment
N8N_BASIC_AUTH_PASSWORD=changeme     # change for any non-local deployment
UI_COOKIE_SECRET=changeme            # signs dashboard session cookies. In non-dev the app REFUSES to start if this is empty/changeme. Set a strong random secret on any deployed stack.
INFRA_BRAIN_DEV=0                    # 1 = local/dev only: opens dashboard + webhook auth (no secret required). MUST be 0/unset on any deployed stack.
ENVIRONMENT=development              # F23: deployed | development. Default (in config) is development so dev/test/local-compose boot freely.
                                     # Hardened deployments (the CI-deployed stack on deploy-host-01 — the dev deployment; there is no production yet)
                                     # MUST set ENVIRONMENT=deployed (k8s/configmap.yaml sets it; "production" is a legacy alias): the app + MCP server
                                     # then REFUSE to boot if INFRA_BRAIN_DEV is also truthy (dev mode must never disable auth on a deployed stack).
COOKIE_SECURE=true                   # Secure attribute on session cookies. Set false for HTTP-only lab/dev stacks served over plain http://.
TRUSTED_PROXY_IPS=                    # TRK-095: comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for login-lockout client-IP attribution.
                                     # SAFE DEFAULT empty = trust none (use raw peer IP, ignore XFF; unspoofable). Set to the fronting proxy/LB address(es) only.
                                     # The proxy must collapse/append into ONE X-Forwarded-For chain (e.g. nginx $proxy_add_x_forwarded_for) for correct hop-order attribution.
TRUSTED_HOSTS=                        # TRK-095 (residual): comma-separated Host header allow-list, wired into Starlette TrustedHostMiddleware (Host-header injection / DNS-rebinding defense).
                                     # OPT-IN, SAFE DEFAULT empty = ["*"] = accept ANY Host (pre-TRK-095 behavior; upgrading never breaks an existing deployment).
                                     # Set to the deployment's public hostname(s), e.g. infra-brain.corp.example,localhost — any other Host is then rejected with HTTP 400.
ADMIN_USERNAME=admin                 # dashboard login username (created by seed if ADMIN_PASSWORD is set)
ADMIN_PASSWORD=changeme              # dashboard login password — REQUIRED for the gated dashboard. With UI_COOKIE_SECRET set
                                     # but this empty, seed_db.py creates NO admin and every login returns 401. If a stack is
                                     # already running, set this and re-run seed, OR use scripts/create_admin.py without a redeploy.
BWS_ACCESS_TOKEN=                    # the ONLY secret set directly in prod (Bitwarden bootstrap)

# ── MCP server ────────────────────────────────────────────────────────────────
# INFRA_BRAIN_MCP_TOKEN removed (auth overhaul, spec Part 1): MCP auth is now
# DB-backed per-key scoped keys managed from the dashboard (/dashboard2/mcpkeys)
# or bootstrapped once via `python -m infra_brain.mcp_auth --bootstrap`.
INFRA_BRAIN_MCP_ENABLE_MUTATIONS=false        # true = allow seed_*/approve/promote/trigger MCP tools. Query tools are always available. RCE tools were removed.
# GitLab #165: TOTAL wall-clock budget (seconds) for an MCP tool that drives an
# LLM reasoning loop (today: query_nl -> QueryAgent.query -> LLMAgent.reason).
# That path bypasses the collector timeout guard entirely, so without this a
# worst-case run is max_iters * LLM_REQUEST_TIMEOUT_SECONDS * retries (~2880s)
# and the MCP client's own transport timeout fires first with no error surfaced.
# Keep comfortably below the calling client's transport timeout. 0 disables.
MCP_TOOL_TIMEOUT_SECONDS=60                   # wall-clock ceiling for LLM-backed MCP tools; 0 disables

# ── Capacity forecast reasoner (GitLab #99) ──────────────────────────────────
CAPACITY_FORECAST_ENABLED=false       # opt-in; CapacityForecastAgent.collect() is a no-op when false
CAPACITY_FORECAST_USED_PCT_THRESHOLD=90.0   # used-percent threshold each datastore trend is projected against

# ── Secrets-manager inventory (GitLab issue #98) ──────────────────────────────
# METADATA-ONLY inventory of an EXTERNAL secrets manager: existence, rotation
# age, referencing system. infra-brain NEVER fetches a secret's value — the
# collector (agents/secrets_inventory.py) has no code path to a value-returning
# endpoint. Unrelated to BWS_ACCESS_TOKEN above (infra-brain's OWN secrets).
SECRETS_INVENTORY_BACKEND=            # "" (off, default) | vault | bitwarden | aws (aws currently unsupported — see agent docstring)
SECRETS_INVENTORY_URL=                # e.g. https://vault.corp.example
SECRETS_INVENTORY_TOKEN=              # read token; grant metadata-read + list ONLY, no capability on the data/value path
SECRETS_INVENTORY_PATHS=              # vault: comma-separated KV-v2 mount/path prefixes (kv/apps,kv/platform); bitwarden: comma-separated organization ids
SECRETS_INVENTORY_SSL_VERIFY=true
SECRETS_INVENTORY_MAX_SECRETS=2000    # hard per-run enumeration cap

# ── Notification-sweep emission cap (M-4) ─────────────────────────────────────
# notify_all() issues one Jira HTTP call + one commit PER open DriftEvent /
# ComplianceViolation. This caps how many notifications ONE sweep may emit per
# sink; any remainder stays `open` for the next sweep (never silently dropped)
# and the truncation is recorded as an audit-trail warning row.
NOTIFICATION_MAX_PER_SWEEP=1000
