# =============================================================================
# Infra Brain — Environment Variable Reference
# =============================================================================
# All fields mirror Settings in src/infra_brain/config.py.
# Default values are shown as example values.
#
# SECRETS (marked "# secret — comes from Bitwarden in prod"):
#   In production, BWS_ACCESS_TOKEN is the only variable you set directly.
#   secrets.load_secrets_into_env() pulls all secret fields from Bitwarden
#   Secrets Manager at startup and injects them into os.environ.
#   For local dev, uncomment and fill in the secret lines below.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic                     # anthropic | bedrock | openai
LLM_MODEL=claude-sonnet-4-6                # anthropic model id (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=                        # secret — comes from Bitwarden in prod
ANTHROPIC_BASE_URL=                        # optional Anthropic-compatible proxy
# B7: additive/opt-in per-role overrides (empty → falls back to LLM_MODEL, i.e.
# today's behavior). Only set if you want a cheaper/faster model for that role.
ANTHROPIC_MODEL_CHAT=                      # optional cheap-tier model for chat
ANTHROPIC_MODEL_SQL=                       # optional cheap-tier model for NL→SQL
ANTHROPIC_MODEL_ROOTCAUSE=                 # optional model for RootCauseAgent's LLM reasoner (Phase 3)

# AWS Bedrock LLM (used when LLM_PROVIDER=bedrock). Auth is IAM: set AWS_*
# credentials below, BEDROCK_PROFILE, or rely on an instance/role chain.
# Requires the 'bedrock' extra: pip install -e ".[bedrock]"
# VERIFY every model id: aws bedrock list-inference-profiles --region <region>
# (ids are region/account-specific; enable model access in the console first).
BEDROCK_MODEL_ID=us.minimax.minimax-m2-5-v1:0   # global default (MiniMax M2.5)
# Per-agent model overrides (empty → BEDROCK_MODEL_ID):
BEDROCK_MODEL_DISCOVERY=us.minimax.minimax-m2-5-v1:0   # agentic tool-loop + JSON
BEDROCK_MODEL_SQL=qwen.qwen3-coder-30b-a3b-v1:0        # NL→SQL
BEDROCK_MODEL_CHAT=zai.glm-4-7-flash-v1:0              # interactive chat
BEDROCK_MODEL_REMEDIATION=qwen.qwen3-coder-30b-a3b-v1:0  # drafts fix MRs
BEDROCK_MODEL_TRIAGE=us.minimax.minimax-m2-5-v1:0       # vuln prioritization
BEDROCK_MODEL_ROOTCAUSE=us.minimax.minimax-m2-5-v1:0    # event correlation
BEDROCK_MODEL_COVERAGE=us.amazon.nova-lite-v1:0         # coverage gap strategy (Nova Lite)
BEDROCK_REGION=us-east-1
BEDROCK_PROFILE=                           # optional named AWS profile

# OpenAI / OpenAI-compatible LLM (used when LLM_PROVIDER=openai). Covers OpenAI
# plus gateways like OpenRouter, LiteLLM, Groq, Together, vLLM.
# Requires the 'openai' extra: pip install -e ".[openai]"
# OpenRouter example: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                     OPENAI_MODEL=anthropic/claude-sonnet-4-6
# Host-run Ollama example (running the stack in docker-compose): the app/
# scheduler/mcp containers are on a bridge network, so a HOST Ollama is NOT at
# "localhost" from inside them. Use host.docker.internal (the compose services
# map it to the host gateway via extra_hosts):
#                     OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#                     OPENAI_MODEL=gemma4:e4b
# Self-hosted omniroute example (node_a multi-provider router; :20129 is the
# OpenAI-compatible inference port — :20128 is the dashboard/admin API, NOT
# an inference endpoint, and :20132 is a WebSocket port, not plain HTTP):
#                     OPENAI_BASE_URL=http://203.0.113.15:20129/v1
#                     OPENAI_MODEL=auto/best-reasoning   # or another auto/* combo alias
# Use an omniroute virtual key scoped to self:usage for OPENAI_API_KEY, not an
# admin key — an admin key can enumerate every other provider key on the
# gateway, which is unnecessary exposure for an inference-only caller.
OPENAI_API_KEY=                            # OpenAI or gateway key (e.g. OpenRouter, omniroute); Ollama accepts any non-empty value
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=                           # empty → official OpenAI; else gateway URL (NOT localhost for host Ollama in compose)
OPENAI_HTTP_REFERER=                       # optional OpenRouter ranking header
OPENAI_APP_TITLE=                          # optional OpenRouter ranking header
# B7: additive/opt-in per-role overrides (empty → falls back to OPENAI_MODEL).
OPENAI_MODEL_CHAT=                         # optional cheap-tier model for chat
OPENAI_MODEL_SQL=                          # optional cheap-tier model for NL→SQL
OPENAI_MODEL_ROOTCAUSE=                    # optional model for RootCauseAgent's LLM reasoner (Phase 3)

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_URL=postgresql://infra:infra@localhost:5433/infra_brain  # secret — comes from Bitwarden in prod
                                                                   # Port 5433 = Docker host-mapped port (for local dev + Claude Code MCP)
                                                                   # Port 5432 = use this only if postgres runs natively (not in Docker)
POSTGRES_READONLY_URL=postgresql://infra_brain_ro:changeme@localhost:5433/infra_brain  # SELECT-only role for the SQL agent (Wave 1.6) — secret, Bitwarden in prod
RUNTIME_CONFIG_ENCRYPTION_KEY=  # Fernet key (TRK-303 part 4/7) for RuntimeConfig secret-category rows — secret, Bitwarden in prod; bootstrap-only, never DB-overridable itself; generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=5             # TRK-092: SQLAlchemy primary-engine pool_size (default unchanged; tune for concurrent sweep+dashboard load)
DB_MAX_OVERFLOW=10         # TRK-092: SQLAlchemy primary-engine max_overflow (default unchanged; right-sizing is a followup ops decision)
# Dashboard LLM cost guardrails (TRK-090 / TRK-091) — Redis-backed, per-user, process-count-invariant.
# Both defaults are STARTING POINTS to tune with real usage data, not load-tested capacity numbers.
CHAT_RATE_LIMIT_PER_HOUR=30        # TRK-090: max /chat + /custom-view calls per user per rolling hour (≈1 per 2 min; above human use, below a runaway loop)
DAILY_TOKEN_BUDGET_PER_USER=500000 # TRK-091: cumulative approx LLM tokens/user/day (≈250 interactions at ~2k tokens) — denial-of-wallet backstop; token counts approximated at ~4 chars/token

# -----------------------------------------------------------------------------
# GitLab
# -----------------------------------------------------------------------------
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=                             # secret — comes from Bitwarden in prod
GITLAB_SSL_VERIFY=true

# -----------------------------------------------------------------------------
# Octopus Deploy
# -----------------------------------------------------------------------------
OCTOPUS_URL=http://octopus.example.com
OCTOPUS_API_KEY=                          # secret — comes from Bitwarden in prod
OCTOPUS_SSL_VERIFY=true
OCTOPUS_HISTORY_DAYS=365                   # deep-capture: time-box tasks/events to last N days
OCTOPUS_EVENTS_CAP=50000                   # hard cap on octopus_events rows per run
OCTOPUS_FETCH_WORKERS=8                    # bounded read concurrency for per-project deploy-process/variable GETs
# Octopus audit-event deep-capture. DEFAULT OFF: event Details can embed PANs
# (test-card numbers in pipeline logs) that DLP fail-closes on. Only enable if
# the event stream is known PAN-free. See docs/READONLY-MODEL.md.
OCTOPUS_COLLECT_EVENTS=false

# -----------------------------------------------------------------------------
# SaaS / API-key inventory (GitLab #103) — metadata only, read-only.
# Empty by default: SaaSInventoryAgent.collect() is a clean no-op until set.
# -----------------------------------------------------------------------------
SAAS_ADMIN_URL=                            # e.g. https://admin.example-saas.com/api
SAAS_ADMIN_TOKEN=                          # secret — comes from Bitwarden in prod
SAAS_VENDOR=                                # optional label for the configured admin API

# -----------------------------------------------------------------------------
# Rapid7 InsightVM
# -----------------------------------------------------------------------------
RAPID7_URL=https://rapid7.example.com
RAPID7_USERNAME=api_key_auth
RAPID7_API_KEY=                           # secret — comes from Bitwarden in prod
RAPID7_SSL_VERIFY=true
RAPID7_VULN_ASSET_CAP=750                  # vuln_queue feeder: cap per-asset vuln fetches to top-N by risk_score
RAPID7_VULN_ROTATION_SLOTS=150             # of that cap, slots reserved for round-robin coverage of below-cap assets (0 = pure top-cap)
RAPID7_VULN_DETAIL_CAP=600                 # vuln-detail enrichment: cap distinct slugs enriched (detail+solutions), top-N by severity

# -----------------------------------------------------------------------------
# Okta IdP (GitLab issue #102 — IdentityAgent)
# -----------------------------------------------------------------------------
OKTA_URL=https://example.okta.com          # org base URL, no trailing /api/v1
OKTA_API_TOKEN=                            # secret — comes from Bitwarden in prod
OKTA_SSL_VERIFY=true

# -----------------------------------------------------------------------------
# Backup verification (GitLab issue #96) — pluggable/generic collector
# -----------------------------------------------------------------------------
BACKUP_BACKEND=                            # "veeam" | "bacula" | "cloud_snapshot" — empty = unconfigured (BackupAgent skips cleanly)
BACKUP_API_URL=                            # e.g. https://veeam.example.com
BACKUP_API_KEY=                            # secret — comes from Bitwarden in prod
BACKUP_SSL_VERIFY=true
BACKUP_OVERDUE_DAYS=2                      # flag a job with no successful backup in this many days
BACKUP_RESTORE_TEST_OVERDUE_DAYS=90        # flag a job whose last DR/restore test is older than this (or never recorded)

# -----------------------------------------------------------------------------
# Reasoner-collector LLM fan-out caps (TRK-109)
# -----------------------------------------------------------------------------
COVERAGE_GAP_LLM_CAP=5                     # max coverage-gap strategies drafted (LLM calls) per coverage run; remainder deferred + logged
REMEDIATION_DRAFT_CAP=25                   # max remediation plans drafted (LLM calls) per remediation run, newest drift first; remainder deferred + logged
# TRK-109 residual: per-call LLM client timeout (seconds). Bounds a SINGLE hung/
# glacial LLM call so it can't consume the whole collect() budget and trip the
# 600s wall-clock guard. Threaded into ChatAnthropic/ChatOpenAI/ChatBedrockConverse.
# Local Ollama on CPU can take 60-120s/call, so keep generous. 0 disables.
LLM_REQUEST_TIMEOUT_SECONDS=120           # per-call LLM client timeout; 0 disables

# -----------------------------------------------------------------------------
# vSphere (requires pip install "infra-brain[vsphere]")
# -----------------------------------------------------------------------------
VSPHERE_HOST=
VSPHERE_USER=
VSPHERE_PASSWORD=                         # secret — comes from Bitwarden in prod
VSPHERE_SSL_VERIFY=true
VSPHERE_FULL_INVENTORY_ENABLED=false      # pulse-first hold: false = only the 15-min pulse auto-runs; true re-enables the scheduled 6h full inventory
VSPHERE_HOSTS=                            # comma-separated vCenter hostnames; overrides VSPHERE_HOST when set
VSPHERE_CONNECT_TIMEOUT=30               # seconds before aborting a vCenter connection
# Two-speed metrics — Speed 2: QueryPerf history (opt-in; full 6h scan only)
VSPHERE_COLLECT_PERF_HISTORY=false       # OFF by default; true enables QueryPerf history enrichment
VSPHERE_PERF_INTERVAL_ID=300             # seconds; 300 = 5-min rollup samples
VSPHERE_PERF_MAX_SAMPLES=12              # samples to fetch (12 × 5 min = last hour)
VSPHERE_PERF_BATCH_SIZE=25               # VMs per QueryPerf call
VSPHERE_METRICS_RETENTION_DAYS=30        # prune append-only vsphere_*_metrics rows older than this

# -----------------------------------------------------------------------------
# Load balancer / reverse proxy / CDN (GitLab issue #100) — all read-only GET
# APIs; each vendor is independently optional (empty host/URL -> skipped).
# -----------------------------------------------------------------------------
LB_ENABLED=false
F5_HOST=
F5_USERNAME=
F5_PASSWORD=                               # secret — comes from Bitwarden in prod
F5_SSL_VERIFY=true
NGINX_PLUS_URL=
HAPROXY_STATS_URL=
HAPROXY_STATS_USERNAME=
HAPROXY_STATS_PASSWORD=                    # secret — comes from Bitwarden in prod
CLOUDFLARE_API_TOKEN=                      # secret — comes from Bitwarden in prod; scoped Zone:Read + Load Balancing:Read
CLOUDFLARE_ZONE_IDS=                       # comma-separated; empty -> discover via /zones

# -----------------------------------------------------------------------------
# Ansible
# -----------------------------------------------------------------------------
ANSIBLE_INVENTORY_PATH=
# CONTAINER-side path above; the two below are the HOST-side paths bind-mounted
# onto it by docker/docker-compose.deploy.yml. Both have working defaults for
# deploy-host-01 and only need setting on a different deploy host.
#
# These exist because the mounts previously lived only in
# docker-compose.homelab.yml, which CI never loads — one manual `docker compose
# up -d` without that overlay silently dropped them and blinded the `linux`
# collector for 8 days (TRK-328). ANSIBLE_DEPLOY_KEY_HOST_PATH is the SAME key
# as SSH_KEY_PATH mounted at a second location, because this fleet's inventory
# group_vars/all.yml pins `ansible_ssh_private_key_file: ~/.ssh/ansible_deploy`.
ANSIBLE_INVENTORY_HOST_PATH=/home/operator/homelab-ansible/inventory
ANSIBLE_DEPLOY_KEY_HOST_PATH=/home/operator/.ssh/ansible_deploy
# Comma-separated exact hostnames LinuxAgent must never record as linux_host
# resources even though they answer the default "all" sweep -- e.g. DNS
# aliases/CNAMEs (an "adopted_dns"-style inventory group) that resolve back
# to a collector host itself rather than being a distinct machine.
LINUX_EXCLUDE_HOSTS=
# F-017: ansible fact-gathering timeouts (seconds) and ping-based host scoping
ANSIBLE_FACTS_TIMEOUT_SECONDS=270
ANSIBLE_PING_TIMEOUT_SECONDS=60
ANSIBLE_PING_SCOPE_ENABLED=true
# Parallelism + per-host SSH connect timeout. Higher forks + a short connect
# timeout keep a fleet-wide ping/gather (e.g. 175 hosts) inside the window;
# default 5 forks serialized unreachable hosts past ANSIBLE_PING_TIMEOUT_SECONDS.
ANSIBLE_FORKS=30
ANSIBLE_CONNECT_TIMEOUT_SECONDS=8
# Exported as ANSIBLE_SSH_ARGS for every ansible run. Re-enables legacy
# host-key/kex algorithms for old fleet servers (ssh-rsa/ssh-dss) that modern
# OpenSSH rejects. Set empty if the fleet is all-modern. Auth still needs a
# valid, authorized key (see SSH_KEY_PATH).
ANSIBLE_SSH_ARGS=-o ControlMaster=auto -o ControlPersist=60s -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedKeyTypes=+ssh-rsa -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
# F-021: WinRM credentials for WindowsAgent (-m win_setup via WinRM).
# Leave ANSIBLE_WIN_PASSWORD empty to skip Windows fact collection (CollectorSkipped).
# The password is injected into the ansible subprocess env — never placed in argv.
ANSIBLE_WIN_USER=Administrator
ANSIBLE_WIN_PASSWORD=            # secret — comes from Bitwarden in prod
# TRK-282: the Linux posture gathers (host_firewall_rules/host_shares —
# iptables -S / exportfs -v / net conf list) need root and run with ansible
# --become (hardcoded, not an env-configurable flag). The fleet SSH account at
# SSH_KEY_PATH / ANSIBLE_DEPLOY_KEY_HOST_PATH above needs passwordless sudo on
# every fleet host for this to succeed — see the exact sudoers drop-in and the
# `[become-denied]` failure signature this raises when sudo is refused in
# docs/runbooks/2026-07-20-live-env-enablement.md, §1 Connectivity.

# Ansible inventory reconciliation (GitLab = source of truth; add-missing only)
INVENTORY_SOURCE_PROJECT_ID=0
INVENTORY_BRANCH=main
INVENTORY_FILE_PATH=                       # canonical file; empty → auto-discover
INVENTORY_DEFAULT_GROUP=discovered
INVENTORY_GROUP_MAP=                        # optional "linux:web,windows:win"
INVENTORY_MATCH_DOMAINS=linux,windows,vsphere,cloud,vuln  # vuln (Rapid7 assets) — domain string is literally "vuln", not "rapid7"
INVENTORY_HOST_TYPES=octopus:octopus_machine,vsphere:vsphere_vm|vsphere_host,vuln:r7_asset,cloud:ec2_instance  # per-domain host-shaped Resource.type filter; domains not listed keep no filter

# MR-J item 3: curated host purpose/VLAN map sync — the seeded curated file
# host_purpose_map.yml at the ROOT of the fleet-inventory repo (GitLab project 6).
HOST_PURPOSE_MAP_PROJECT_ID=6              # GitLab project id of playbooks/fleet-inventory where host_purpose_map.yml lives; 0/unset = sync disabled; set to 6 to enable
HOST_PURPOSE_MAP_BRANCH=main
HOST_PURPOSE_MAP_FILE_PATH=host_purpose_map.yml   # path within that repo

# Remediation — approved fix proposals open an MR to this GitLab project (0 = off)
REMEDIATION_PROJECT_ID=0
REMEDIATION_BRANCH=main

# GitLab #108 — approved compliance_rule_gap proposals open an MR editing
# rules/enforcement/compliance.yml in this GitLab project (0 = off; normally
# the infra-brain project itself, since that's where the file lives)
COMPLIANCE_RULES_PROJECT_ID=0
COMPLIANCE_RULES_BRANCH=main

# -----------------------------------------------------------------------------
# Container registry scanning (GitLab issue #101) — registry-agnostic OCI
# Distribution API v2. Comma-separated base URLs; leave empty to keep
# ContainerRegistryAgent idle.
# 2026-08-02 audit: the only registry candidate in this lab is the self-hosted
# GitLab (https://gitlab.example.internal) — no registry endpoint is recorded anywhere
# in-repo. If its Container Registry feature is enabled, put its base URL here
# (GitLab admin area shows it; private registries also need
# CONTAINER_REGISTRY_TOKEN below).
# -----------------------------------------------------------------------------
CONTAINER_REGISTRIES=
CONTAINER_REGISTRY_TOKEN=
CONTAINER_REGISTRY_SSL_VERIFY=true
CONTAINER_REGISTRY_REPO_CAP=200
CONTAINER_REGISTRY_TAG_CAP=20

# -----------------------------------------------------------------------------
# Home-lab monitoring/observability collectors — every URL empty means the
# corresponding agent stays idle (CollectorSkipped). Each is a read-only HTTP
# client against the named service's own API.
# -----------------------------------------------------------------------------
HOMELAB_SERVICES_MANIFEST_PATH=          # "" -> HomelabServicesAgent's bundled default
# Real instance on node_a (homelab_services_manifest.json "prometheus");
# live-verified 2026-08-02: GET /api/v1/status/buildinfo -> v2.55.1. No auth needed.
PROMETHEUS_URL=http://203.0.113.15:9090
PROMETHEUS_SSL_VERIFY=true
# Real instance on node_a (manifest "grafana"); live-verified 2026-08-02:
# GET /api/health -> v11.5.2. URL alone enables the health tier; dashboards/
# alerts additionally need GRAFANA_API_TOKEN (a real credential, see below).
GRAFANA_URL=http://203.0.113.15:3002
GRAFANA_API_TOKEN=                       # "" -> only the anonymous /api/health check runs
# The manifest lists an "alertmanager" service on node_a but records no URL,
# and a probe of the conventional port (203.0.113.15:9093) got no response
# (2026-08-02). Find the real listen address in the node_a monitoring compose
# stack (alertmanager service ports) and fill it in here.
ALERTMANAGER_URL=
ALERTMANAGER_TOKEN=
# Real instance on node_a (manifest "uptime-kuma"); live-verified 2026-08-02:
# GET /api/status-page/heartbeat/default -> 200. NOTE: the heartbeat list came
# back EMPTY and /api/status-page/default did not answer — no published status
# page named "default" appears to exist yet. The collector needs a published
# status page: create one in the Kuma UI (Settings -> Status Pages), assign
# monitors to it, and put its slug in UPTIME_KUMA_STATUS_PAGE_SLUG.
UPTIME_KUMA_URL=http://203.0.113.15:3001
UPTIME_KUMA_STATUS_PAGE_SLUG=default     # confirm the real slug — see the agent's docstring
# A real Wazuh stack runs on node_a (manifest: wazuh-indexer :9200, wazuh-
# dashboard https://203.0.113.15/, wazuh-manager URL unrecorded). This
# collector talks to the MANAGER's REST API (conventionally https://<host>:55000),
# not the indexer — and it is credential-gated: all three of URL/username/
# password must be set (API creds live in the Wazuh manager config/Bitwarden).
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_SSL_VERIFY=true
WAZUH_AGENTS_CAP=500
WAZUH_ALERTS_WINDOW_HOURS=24
WAZUH_ALERTS_CAP=200
# Wazuh Indexer (OpenSearch) — alert SEARCH lives here, NOT on the Manager API
# above. Wazuh 4.x moved it with the OpenSearch stack, so port 55000 has no
# /alerts route and leaving this empty means alerts are never collected (agent
# inventory still works). Typically port 9200 on the same host as the manager.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_SSL_VERIFY=true
# Override only if the deployment renames/rotates its alert indices.
WAZUH_INDEXER_ALERTS_INDEX=wazuh-alerts-*

# -----------------------------------------------------------------------------
# infra-ops hook write path (P5.1/P5.2) — the plugin's stdlib-only hooks
# reach record_observation/record_client_state/record_governance_event over
# plain REST (api/routers/internal_state.py), not MCP (see that file's
# docstring for why). Empty = fail-closed unless INFRA_BRAIN_DEV=1.
# -----------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=                   # secret — comes from Bitwarden in prod

# -----------------------------------------------------------------------------
# MCP hardening (P4.4a) — opt-in. Default false preserves the documented
# TRK-247 direct-invocation behavior (detect-and-stamp, never block — a
# legitimate ops/debug path). Set true for a harder boundary.
# -----------------------------------------------------------------------------
INFRA_BRAIN_MCP_DENY_DIRECT_INVOCATION=false

# -----------------------------------------------------------------------------
# Headless runner (P6.1/P6.2, D10) — standing tasks (drift-triage,
# self-review, EOL report) call the MCP server over real HTTP with this
# scoped bearer token so their actions attribute as "mcp:headless-runner"
# and are independently revocable. Mint via scripts/mint_headless_runner_key.py.
# Empty token = standing tasks are a clean no-op (no jobs registered).
# URL default is loopback because the scheduler container runs with
# network_mode: host (see docker-compose.yml) — it cannot resolve the mcp
# service's compose DNS name, same reason POSTGRES_URL/REDIS_URL are
# loopback-overridden for that service.
# -----------------------------------------------------------------------------
HEADLESS_RUNNER_MCP_URL=http://127.0.0.1:8002/mcp
HEADLESS_RUNNER_MCP_TOKEN=                # secret — comes from Bitwarden in prod

# -----------------------------------------------------------------------------
# Network devices (read-only SNMP — requires pip install "infra-brain[net]")
# Leave SNMP_TARGETS empty to keep the NetAgent idle.
# -----------------------------------------------------------------------------
SNMP_TARGETS=
SNMP_COMMUNITY=
SNMP_PORT=161
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1

# -----------------------------------------------------------------------------
# Network discovery (NetDiscoveryAgent — active shadow-IT & threat sweep)
# IMPORTANT: Read the spec at docs/specs/2026-06-29-netdiscovery-agent-design.md
# before changing aggressiveness or exclusion settings in production.
# Populate NETDISCOVERY_EXCLUDE_CIDRS before first run if any routable CDE
# segment must be protected (the only never-probe carve-out).
# -----------------------------------------------------------------------------
# Safety dial: passive | polite (DEFAULT) | normal | aggressive
NETDISCOVERY_AGGRESSIVENESS=polite
# CDE / sensitive CIDRs that must NEVER be probed (comma-separated).
NETDISCOVERY_EXCLUDE_CIDRS=
# Tier enablement (true = enabled, default).
NETDISCOVERY_ENABLE_PING_SWEEP=true
NETDISCOVERY_ENABLE_PORT_SCAN=true
# Rate controls (conservative defaults — raise only after profiling impact).
# TRK-280/TRK-281: bumped 50 -> 100 pkt/s. Docker-bridge routes never reach
# this cap (filtered by NETDISCOVERY_MAX_SUBNET_HOSTS below before any nmap
# call) — this only throttles a genuine reachable LAN sweep.
NETDISCOVERY_MAX_RATE=100
# Tier 1 scope + budget guards (TRK-239). `ip route` inside the container also
# reports the Docker bridge network (a /16) — far too large to sweep inside
# COLLECT_TIMEOUT_SECONDS and out of scope anyway. Routes bigger than
# NETDISCOVERY_MAX_SUBNET_HOSTS addresses are skipped and recorded as a Tier 1
# error (the run reports "partial", not "failed"). Set
# NETDISCOVERY_INCLUDE_CIDRS to pin the sweep to the real LAN ranges.
NETDISCOVERY_MAX_SUBNET_HOSTS=1024
# 2026-08-02 audit: on this deployment (ai_node VPS, network_mode: host) `ip route`
# main-table shows ONLY the provider's public /21 (must never be swept), Docker
# bridge /16s (all skipped by the host cap above — the cause of every current
# netdiscovery "failed" run), and NO local LAN. The actual fleet lives on
# Tailscale /32 peer routes (policy table 52), which `ip route` — and therefore
# this collector — cannot see. Operator decision needed: either pin this to
# narrow docker-bridge slices (e.g. 172.17.0.0/24,172.18.0.0/24) to inventory
# local containers and stop the failure noise, or pause the netdiscovery domain
# on this host (dispatchable__netdiscovery override) — tailnet hosts are already
# inventoried via homelab_services/linux collectors.
NETDISCOVERY_INCLUDE_CIDRS=
# Per-subnet nmap cap, and the whole-Tier-1 budget (keep well under
# COLLECT_TIMEOUT_SECONDS so partial results survive).
# TRK-280/TRK-281: bumped 120 -> 300 — a 254-host -sn ping sweep of a real,
# newly host-network-reachable /24 (e.g. 192.0.2.11/24 per MR !264) was
# live-timing-out at 120s; oversized/Docker-bridge routes never reach nmap at
# all (filtered above), so this only ever bounds a genuine LAN sweep.
NETDISCOVERY_SUBNET_TIMEOUT_SECONDS=300
NETDISCOVERY_TIER1_BUDGET_SECONDS=480
# Whole-Tier-2 wall-clock budget (TRK-280/281 follow-up) — Tier 2 started
# blowing the outer 600s guard once Tier 1 found real hosts on a
# previously-unreachable LAN; this bounds it the same way Tier 1 is bounded.
NETDISCOVERY_TIER2_BUDGET_SECONDS=480
# Hosts per nmap invocation within a Tier 2 scan group. Live-measured
# 2026-07-30: ~27s/host at the "polite" profile, so this is sized for several
# chunks to complete within the budget rather than one oversized chunk
# consuming it all. Full ~150-host LAN coverage in one cycle is NOT achieved
# at this throttle -- see TRK-280 capacity follow-up.
NETDISCOVERY_TIER2_CHUNK_SIZE=3
# Fragile-device protection — ICMP/single-port only regardless of aggressiveness.
NETDISCOVERY_FRAGILE_CIDRS=
NETDISCOVERY_FRAGILE_HOSTS=
# DNS resolver for passive Tier 0 sweep (empty = system default).
NETDISCOVERY_DNS_RESOLVER=
# Watchlists (comma-separated port numbers and keyword signatures).
NETDISCOVERY_DANGEROUS_PORTS=23,445,3389,5900,2323
NETDISCOVERY_SUSPICIOUS_SIGNATURES=teamviewer,anydesk,cobalt strike,meterpreter,empire,metasploit,ngrok,frp,chisel,rathole,ncat,netcat

# -----------------------------------------------------------------------------
# DNS zone/record monitoring (GitLab issue #95) — strictly opt-in.
# -----------------------------------------------------------------------------
# Comma-separated authoritative zone names to monitor, e.g. example.com,corp.internal
# example.internal is this home lab's real zone (Cloudflare-hosted — mail/git/docs.example.internal
# in homelab_services_manifest.json; SOA query live-verified 2026-08-02). AXFR will
# be refused by Cloudflare; the agent treats AXFR as best-effort and still records SOA.
DNS_ZONES=example.internal
# Resolver to query (empty = system default resolver via dnspython).
DNS_RESOLVER_HOST=
DNS_QUERY_TIMEOUT_SECONDS=10
# Optional positive allow-list gate (residual 1, GitLab #95): comma-separated
# zone names. Empty (default) = no restriction, every configured dns_zones
# entry is queried. Mirrors NETDISCOVERY_INCLUDE_CIDRS' positive-allowlist
# shape.
DNS_ALLOWED_ZONES=example.internal

# -----------------------------------------------------------------------------
# Jira
# -----------------------------------------------------------------------------
JIRA_URL=https://jira.example.com
JIRA_TOKEN=                               # secret — comes from Bitwarden in prod
JIRA_PROJECT_KEY=INFRA
JIRA_USER_EMAIL=

# -----------------------------------------------------------------------------
# Confluence
# -----------------------------------------------------------------------------
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_TOKEN=                         # secret — comes from Bitwarden in prod
CONFLUENCE_SPACE_KEY=INFRA
CONFLUENCE_USER_EMAIL=

# -----------------------------------------------------------------------------
# RAG knowledge store (TRK-067) — strictly opt-in
# -----------------------------------------------------------------------------
RAG_ENABLED=false                          # false (default) = ingest agent + search_knowledge tools inert
EMBEDDING_PROVIDER=                        # ""=auto (bedrock unless llm_provider is openai); or bedrock|openai
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# EMBEDDING_OPENAI_BASE_URL (optional): point embeddings at a DIFFERENT
# OpenAI-compatible gateway than chat's OPENAI_BASE_URL -- e.g. chat on a
# cloud router but embeddings on a local Ollama instance, to avoid a
# rate-limited upstream free tier some embedding-serving gateways proxy
# (e.g. omniroute's Gemini-backed embeddings hit a 100 req/min free-tier
# cap in one bulk-ingest batch -- verified live). Empty = falls back to
# OPENAI_BASE_URL.
# Local Ollama example (the live deployment's actual config): mxbai-embed-large
# natively emits 1024 dims, matching EMBEDDING_DIM below exactly -- no
# truncation needed, no external rate limit. Ollama must be bound beyond
# 127.0.0.1 (systemd override: OLLAMA_HOST=<tailnet-ip>:11434) for anything
# off-host to reach it -- a container's "localhost" is itself, not the
# docker host, so binding a remote Ollama to a real tailnet IP (not
# host.docker.internal, which only helps for Ollama running ON the same
# host as the compose stack) is what makes this reachable at all.
#                     EMBEDDING_OPENAI_BASE_URL=http://203.0.113.17:11434/v1
#                     EMBEDDING_OPENAI_MODEL=mxbai-embed-large
EMBEDDING_OPENAI_BASE_URL=
# Self-hosted omniroute example: only Gemini-family embedding models are
# actually served (verified live) -- text-embedding-3-small does not exist
# there. Native output is 3072 dims, which pgvector's HNSW index cannot
# index (hard cap: 2000 dims) -- the factory truncates+renormalizes to
# EMBEDDING_DIM client-side (embeddings.py _TruncatedEmbeddings), since the
# gateway also rejects the OpenAI `dimensions` server-side truncation param.
# Gemini's embed_content free tier also caps at 100 req/min (verified live
# -- a single bulk-ingest run exceeds it immediately) -- set
# EMBEDDING_BATCH_PACING_SECONDS=65 if you use this path, or bulk ingestion
# will fail outright rather than just run slowly.
#                     EMBEDDING_OPENAI_MODEL=gemini/gemini-embedding-001
#                     EMBEDDING_DIM=1536
#                     EMBEDDING_BATCH_PACING_SECONDS=65
EMBEDDING_BATCH_PACING_SECONDS=0           # seconds between embed_documents() batches; 0 (default) = off, only needed for a rate-limited gateway
EMBEDDING_DIM=1024                         # must match model + document_chunks.embedding column; changing needs re-embed
CONFLUENCE_RAG_SPACES=                     # comma-separated space keys; empty = fall back to CONFLUENCE_SPACE_KEY
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.0                      # TRK-122 R3: cosine floor; 0.0 (default) = no floor (byte-identical); calibrate live
RAG_HYBRID_ENABLED=true                     # TRK-297 R6: fuse Postgres FTS (ts_rank) with cosine via RRF k=60; false = pure cosine. Subordinate to RAG_ENABLED; needs migration 2a7f1c9e4d30
EMBEDDING_QUERY_PREFIX=                     # TRK-122 R4: mxbai asymmetric-retrieval query prefix; empty = off. e.g. "Represent this sentence for searching relevant passages: "
# TRK-122 R1: filesystem root LocalDocsAgent ingests curated repo docs from; empty = agent inert.
# The image ships docs/ at /app/docs specifically for this agent (docker/Dockerfile
# "COPY docs/ docs/", WORKDIR /app) — /app/docs is the intended in-container value.
REPO_DOCS_ROOT=/app/docs
RAG_CHUNK_SIZE=1000                         # per-chunk char budget (prefix subtracted); 1000 keeps margin under mxbai's 512-token window (WordPiece ~1.1-1.3x); changing the embedding model needs re-tuning
EMBEDDING_MAX_TOKENS=512                     # embedding model's hard token-window ceiling (mxbai-embed-large=512); the constraint RAG_CHUNK_SIZE is sized against
PERSONAL_WIKI_INGEST_ENABLED=false          # false (default) = PersonalWikiAgent inert; separate opt-in from RAG_ENABLED on purpose (real personal data)
PERSONAL_WIKI_ROOT=                          # filesystem root PersonalWikiAgent ingests entities/, wiki/, raw/ from (e.g. ~/.hermes/wiki); empty = agent inert; runtime/ is always skipped

# -----------------------------------------------------------------------------
# Ops alert webhook (OB-1) — collection-health, scheduler dead-man switch,
# and agent-anomaly alerts. Empty URL = clean no-op.
# -----------------------------------------------------------------------------
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TOKEN=                        # secret — comes from Bitwarden in prod
# TRK-241 (GitLab #110): consecutive-unhealthy-pass streak that escalates a
# collection-health alert (prefixed "ESCALATED"). Alert-only.
COLLECTION_HEALTH_ESCALATION_STREAK=3

# --- In-app ops-alert receiver (TRK-135 / TRK-329) ----------------------------
# Bearer token accepted by POST /webhooks/ops-alert, the app's OWN alert
# destination. Empty = the receiver is OFF and answers 503 — it is never open
# when unset (an unconfigured receiver must not be an unauthenticated one), and
# unlike the WEBHOOK_*_SECRET values below it has NO INFRA_BRAIN_DEV escape.
OPS_WEBHOOK_RECEIVER_TOKEN=               # secret — comes from Bitwarden in prod
#
# RECIPE — give alerting a destination with zero external services:
#
#   OPS_WEBHOOK_URL=http://app:8000/webhooks/ops-alert
#   OPS_WEBHOOK_TOKEN=<same random value as the line below>
#   OPS_WEBHOOK_RECEIVER_TOKEN=<a random value, e.g. `openssl rand -hex 32`>
#
# (Inside docker/docker-compose.yml the app service is reachable as
# http://app:8000; on the host use http://localhost:8000. The deadman-prober
# container already receives OPS_WEBHOOK_URL/OPS_WEBHOOK_TOKEN — see
# docker/docker-compose.yml — so it needs no further wiring.)
#
# With those three set, BOTH existing producers start delivering:
#   * the in-app path (tools/ops_webhook.py send_ops_alert — freshness monitor,
#     deadman checks, entity-retirement alerts), and
#   * the standalone deadman-prober container, whose alerts previously had NO
#     persistence fallback and simply vanished when the app was down.
# Both land as audit rows visible on the dashboard Activity page
# (get_audit_log(allowed=False)).
#
# This is the FLOOR, not a pager. It guarantees alerts are durable and visible;
# it does not wake anyone up at 3am. A real external channel (PagerDuty,
# Opsgenie, Slack, Alertmanager) is still strictly better — OPS_WEBHOOK_URL
# stays a plain swappable setting, so repoint it whenever one exists and this
# endpoint simply stops receiving. What it removes is the "no destination at
# all" state that let an 8-day collector outage pass unnoticed (TRK-328).

# -----------------------------------------------------------------------------
# Chatops bot (GitLab #111) — inbound Slack Events API / slash-command and
# Teams outgoing-webhook payloads, answered by the same read-only chat agent
# the dashboard uses. Empty secrets = feature dark (routes fail closed, 403).
# CODE-COMPLETE BUT NOT LIVE: needs real Slack app + Teams bot credentials
# from Bitwarden before CHATOPS_ENABLED=true means anything in a real
# workspace — see docs/TRACKER.md GitLab #111 entry.
# -----------------------------------------------------------------------------
CHATOPS_ENABLED=false
SLACK_SIGNING_SECRET=                     # secret — comes from Bitwarden in prod
SLACK_BOT_TOKEN=                          # secret (xoxb-...) — comes from Bitwarden in prod
TEAMS_OUTGOING_WEBHOOK_SECRET=            # secret — comes from Bitwarden in prod
# Comma-separated allowlist of Slack team ids / Teams tenant ids permitted to
# use the bot — empty means deny everything even with CHATOPS_ENABLED=true
# and valid secrets (fail closed; there is no "allow all" default).
CHATOPS_ALLOWED_SLACK_TEAM_IDS=
CHATOPS_ALLOWED_TEAMS_TENANT_IDS=

# -----------------------------------------------------------------------------
# Context7
# -----------------------------------------------------------------------------
CONTEXT7_API_KEY=                         # secret — comes from Bitwarden in prod

# -----------------------------------------------------------------------------
# API Operational Tunables
# -----------------------------------------------------------------------------
API_PAGE_SIZE=100
API_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Sweep Graph (Phase 2 orchestration v2.1) — strictly opt-in
# -----------------------------------------------------------------------------
SWEEP_GRAPH_ENABLED=false                 # false (default) = today's per-domain cron + dispatch() behavior, byte-identical
SWEEP_GRAPH_SCHEDULE="0 */4 * * *"        # cron for the single full-sweep job; only registered when SWEEP_GRAPH_ENABLED=true

# -----------------------------------------------------------------------------
# RootCause LLM Reasoner (Phase 3 Task 2) — strictly opt-in
# -----------------------------------------------------------------------------
ROOTCAUSE_LLM_ENABLED=false               # false (default) = deterministic timeline correlation, byte-identical to today
ROOTCAUSE_LLM_MAX_EVENTS_PER_RUN=20       # per-run cap on LLM reasoning loops; overflow events use the deterministic path

# -----------------------------------------------------------------------------
# Compliance Gap-Finder (Phase 3 Task 3) — strictly opt-in
# -----------------------------------------------------------------------------
COMPLIANCE_GAP_FINDER_ENABLED=false        # false (default) = only the 4 deterministic rules run; true adds an LLM-assisted propose-only rule-gap suggester

# -----------------------------------------------------------------------------
# Remediation Interrupt Mini-Graph (Phase 3 Task 4) — strictly opt-in
# -----------------------------------------------------------------------------
REMEDIATION_INTERRUPT_ENABLED=false       # false (default) = poll-only approval flow, byte-identical to today; true also parks a durable interrupt graph per drafted action

# -----------------------------------------------------------------------------
# Per-run LLM token ceiling — in-process cost/runaway-spend safety net (TRK-120)
# -----------------------------------------------------------------------------
LLM_RUN_TOKEN_CEILING_ENABLED=false        # false (default) = no ceiling, byte-identical to today; true stops FURTHER LLM calls in a run once the ceiling is reached, degrading to the deterministic/templated fallback
LLM_RUN_TOKEN_CEILING=100000               # cumulative tokens per agent run before further LLM calls are refused (only enforced when LLM_RUN_TOKEN_CEILING_ENABLED=true)
LLM_TOOL_RESULT_MAX_CHARS=8000             # per-tool-result char budget in the agent ReAct transcript (a ReAct loop re-reads every result on every turn); model-transcript only — deterministic collectors still get full output; <=0 falls back to 8000

# -----------------------------------------------------------------------------
# Integration confidence gate (TRK-182 follow-up)
# -----------------------------------------------------------------------------
INTEGRATION_CONFIDENCE_GATE=0.70           # minimum Instinct.confidence to count as an "applied instinct" / auto-eligible integration proposal; was hardcoded 0.7 in fleet.py and Intprops.tsx

# -----------------------------------------------------------------------------
# Knowledge-graph stale-edge decay (TRK-089)
# -----------------------------------------------------------------------------
IS_SAME_AS_DECAY_DAYS=14                   # IS_SAME_AS confidence-decay window in days (default 14 = today's behavior)
GRAPH_EDGE_DECAY_ENABLED=false            # false (default) = ONLY IS_SAME_AS edges decay (byte-identical to today); true additionally decays heuristic/evidence-derived edges (VULNERABLE_TO, AFFECTED_BY, TRIGGERED_BY, DEPLOYED_VIA, HAS_SOFTWARE, RUNS_EOL) on their per-type windows

# -----------------------------------------------------------------------------
# Collection Tunables
# -----------------------------------------------------------------------------
COLLECT_TIMEOUT_SECONDS=300               # per-agent collect() wall-clock limit
COLLECTION_DISABLED_DOMAINS=             # F-022: comma-separated domain names to skip without error (e.g. "vsphere,windows"); empty = all domains enabled
COLLECTION_REVIVED_DOMAINS=              # comma-separated retired domains (AgentSpec.retired=True) to turn back ON without a code change; only ever enables, never disables; empty = retired stays retired
COLLECTION_RUN_STALE_AFTER_HOURS=6        # F20: in_progress collection_runs older than this are reaped to failed by the hourly job (process likely died)

# -----------------------------------------------------------------------------
# Embedded scheduler (F18)
# -----------------------------------------------------------------------------
# false (default) = the FastAPI/API process registers NO cron jobs; the dedicated
# scheduler service (compose `scheduler` / k8s/scheduler.yaml, replicas:1) is the
# ONLY scheduler. This is correct for BOTH dev and prod compose (both run a
# dedicated scheduler). Set true ONLY for a single-process all-in-one deployment
# that has no separate scheduler — otherwise every unlocked job runs once per API
# replica (duplicate alerts/notifications + multiplied LLM spend). The dead-man
# heartbeat CHECK loop in the API runs regardless of this flag.
EMBEDDED_SCHEDULER_ENABLED=false
IAC_MAX_PROJECTS=100                      # max GitLab projects IaCAgent scans per run (matches config.py default)
IAC_GROUP_IDS=                            # comma-separated GitLab group IDs to scan (e.g. "35,15,27"); empty = all projects visible to the token

# -----------------------------------------------------------------------------
# Data Retention (F-030 — PCI DSS 10.7: audit-trail history >= 1 year)
# Enforced by the daily 04:30 UTC prune job. See docs/RETENTION-POLICY.md.
# -----------------------------------------------------------------------------
RETENTION_PRUNE_ENABLED=true               # master switch for the daily prune job
RETENTION_AUDIT_LOG_DAYS=400               # audit_log rows older than this are deleted (PCI >= 365)
RETENTION_AGENT_ACTION_LOG_DAYS=400        # agent_action_log rows (PCI >= 365)
RETENTION_SNAPSHOTS_DAYS=90                # snapshots + resource_configs rows
RETENTION_DRIFT_EVENTS_DAYS=180            # resolved (status != open) drift_events only
RETENTION_COLLECTION_RUNS_DAYS=180         # collection_runs (children detached/deleted first)
RETENTION_CHECKPOINTS_DAYS=30              # LangGraph checkpoints/checkpoint_writes/checkpoint_blobs; threads with a pending/approved ProposedAction are never pruned (TRK-069)

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
DLP_FAIL_CLOSED=true
SCAN_READONLY_ENFORCE=true
INTEGRATION_APPROVAL_REQUIRED=true

# -----------------------------------------------------------------------------
# Zones
# -----------------------------------------------------------------------------
DEFAULT_ZONE=corpor

# -----------------------------------------------------------------------------
# Kubernetes
# -----------------------------------------------------------------------------
K8S_CLUSTER_NAME=                    # optional label for the in-context cluster (agents/k8s.py); empty = unlabeled

