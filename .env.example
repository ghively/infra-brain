# Webhook Secrets
# Empty = dev mode (allow all) unless webhook_auth_required=true.
# In prod, set all secrets and set webhook_auth_required=true to fail closed.
# -----------------------------------------------------------------------------
WEBHOOK_GITLAB_SECRET=                    # secret — comes from Bitwarden in prod
WEBHOOK_OCTOPUS_SECRET=                   # secret — comes from Bitwarden in prod
WEBHOOK_ANSIBLE_SECRET=                   # secret — comes from Bitwarden in prod
WEBHOOK_GENERIC_SECRET=                   # secret — comes from Bitwarden in prod
# TRK-242 (GitLab #113): incident-management ack-in webhook (PagerDuty/Opsgenie)
WEBHOOK_INCIDENT_SECRET=                  # secret — comes from Bitwarden in prod
