# Vendored third-party assets are fetched/built artifacts, not source text.
# Without this, git's text auto-detection + a dev machine's core.autocrlf can
# silently rewrite LF -> CRLF on checkout, changing file bytes and breaking
# the pinned SRI hashes in support.js / test_vendored_assets.py (see
# fix/sri-hash-mismatch: hashes computed on a Windows checkout didn't match
# the canonical git blob that Linux CI checks out).
src/infra_brain/dashboard/static/vendor/** -text -diff binary

# dashboard2 build output must be byte-identical between a Windows dev build
# and the Linux CI staleness check (dashboard-app-lint runs `git diff
# --exit-code -- static2/`). The build itself normalizes to LF
# (dashboard-app/scripts/normalize-eol.mjs); -text stops git/autocrlf from
# rewriting those bytes on checkout. Same rationale as the vendor rule above.
src/infra_brain/dashboard/static2/** -text
