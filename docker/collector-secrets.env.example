# infra-brain collector credentials — TEMPLATE.
#
# Copy this to the HOST at /opt/infra-brain/collector-secrets.env (root:root, chmod 600)
# and fill in real values. This file is HOST-ONLY:
#   * NOT committed to git (see .gitignore — only this .example is tracked)
#   * NOT in the GitLab INFRA_BRAIN_ENV CI variable
#   * NOT in Bitwarden
#
# docker-compose.yml layers it into app/scheduler/mcp via env_file (after ../.env),
# with required:false so a missing file never breaks the deploy. Restart the
# affected service after editing so the new values load.
#
# Leave a collector's lines out entirely to keep it a clean no-op.

# ------------------------------------------------------------------ vSphere
# VSPHERE_HOSTS = comma-separated vCenter host(s)/IP(s); overrides VSPHERE_HOST.
VSPHERE_HOSTS=REPLACE_WITH_VCENTER_HOST_OR_IP
VSPHERE_USER=REPLACE_WITH_READONLY_SERVICE_ACCOUNT
VSPHERE_PASSWORD=REPLACE_WITH_PASSWORD
# true = verify TLS (valid cert); false = allow self-signed vCenter cert.
VSPHERE_SSL_VERIFY=false

# ------------------------------------------------------------------ Octopus
# Rotate a NEW API key for a service account WITH the EventView permission
# (a stale key returns 401). Format: API-XXXXXXXXXXXXXXXXXXXXXXXXXXX
OCTOPUS_URL=https://198.51.100.20
OCTOPUS_API_KEY=REPLACE_WITH_NEW_API_KEY
