# =============================================================================
# Langfuse v3 stack — environment variable reference (docker/langfuse/)
# =============================================================================
# Separate compose project from the main infra-brain stack. Copy to
# docker/langfuse/.env and fill in real values before `docker compose up`.
# NEVER commit a filled-in .env — this file holds placeholders only.
#
# CI never deploys this stack. Operator-only, manual deploy (see README.md).
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (Langfuse's own metadata DB — NOT the infra-brain postgres)
# -----------------------------------------------------------------------------
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=                # secret — generate, store in Bitwarden

# -----------------------------------------------------------------------------
# ClickHouse (trace/observation event store)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=langfuse_clickhouse
CLICKHOUSE_PASSWORD=                       # secret — generate, store in Bitwarden

# -----------------------------------------------------------------------------
# MinIO (S3-compatible blob store for large trace payloads/media)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=langfuse_minio
MINIO_ROOT_PASSWORD=                       # secret — generate, store in Bitwarden (min 8 chars)

# -----------------------------------------------------------------------------
# Langfuse application secrets
# -----------------------------------------------------------------------------
# NEXTAUTH_SECRET / SALT / ENCRYPTION_KEY: generate with
#   openssl rand -hex 32
# Each MUST be unique per deployment — do not reuse across environments.
NEXTAUTH_SECRET=                           # secret
SALT=                                      # secret
ENCRYPTION_KEY=                            # secret — 64 hex chars (32 bytes)

# Public base URL the web UI/API is reachable at (used for OAuth callbacks, links
# in emails, etc). Set to the real reverse-proxy URL in production.
NEXTAUTH_URL=http://localhost:3000

# Telemetry — Langfuse's own product-analytics phone-home. This project's
# read-only guarantee and audit posture require this OFF.
TELEMETRY_ENABLED=false

# -----------------------------------------------------------------------------
# Optional: first-org/project auto-provisioning (Langfuse v3 supports bootstrap
# via env). Leave blank to provision manually through the web UI on first login.
# -----------------------------------------------------------------------------
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
